# Copy this file to .env on the server (never commit .env).
# ----- Site -----
NEXT_PUBLIC_SITE_URL=https://zubairakbar.com
# Set to 1 on a staging server so search engines don't index it
NEXT_PUBLIC_NOINDEX=0
PORT=3000

# ----- Contact form email (SMTP mailbox that sends the messages) -----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=contact@zubairakbar.com
SMTP_PASS=
CONTACT_TO=contact@zubairakbar.com
CONTACT_FROM=contact@zubairakbar.com

# ----- Spam protection (Cloudflare Turnstile; leave empty to switch off) -----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ----- Analytics (loads only after the visitor accepts analytics cookies) -----
# Example for a self-hosted Umami: https://analytics.example.com/script.js + website ID
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_ID=

# ----- Google Search Console verification code (optional) -----
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
